{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ai-application",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/health"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EngineeringCodexAgent",
        "class_name": "EngineeringCodexAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EngineeringCodexAgent"],
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
}
