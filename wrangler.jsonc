{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "engineering-codex-coach",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EngineeringCodexAgent",
        "class_name": "EngineeringCodexAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EngineeringCodexAgent"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
