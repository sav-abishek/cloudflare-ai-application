{
  "name": "engineering-codex-coach",
  "version": "0.1.0",
  "private": true,
  "description": "A durable AI assistant for engineering readiness, built on Cloudflare.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run check && vite build && wrangler deploy",
    "types": "wrangler types env.d.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src test vite.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "^0.11.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "^0.22.0",
    "ai": "^6.0.197",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "workers-ai-provider": "^3.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.113.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1"
}
